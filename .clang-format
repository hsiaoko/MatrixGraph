# Google C++ style, with this project's pointer convention and include layout.
Language: Cpp
BasedOnStyle: Google

# The Google guide accepts either; this project writes `int& foo`.
DerivePointerAlignment: false
PointerAlignment: Left

# Project headers (quoted "core/...") first, then system/third-party (<...>).
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^".*"$'
    Priority: 1
  - Regex: '^<.*>$'
    Priority: 2
SortIncludes: CaseSensitive

# Keep each file's existing line endings (gemm.cu is CRLF).
DeriveLineEnding: true
UseCRLF: false